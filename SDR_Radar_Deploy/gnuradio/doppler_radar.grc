- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nDoppler Speed Camera - GNU Radio embedded Python block\
      \ (source of the epy_block in doppler_radar.grc).\n\nInput : complex Doppler\
      \ signal at 8 kS/s (the received CW tone mixed to 0 Hz and decimated).\nDisplay:\
      \ live_text() and held_text() return the readouts; Function Probe blocks poll\
      \ them for QT GUI Labels.\nProcessing is shared with the Python radar (../doppler_core.py):\
      \ clutter map, mirror test,\nsub-bin peak, pass tracking, capture over the speed\
      \ limit, speed_log.csv, Arduino LED/buzzer.\n\"\"\"\nimport os\nimport sys\n\
      import numpy as np\nfrom gnuradio import gr\n\n\ndef _import_core():\n    \"\
      \"\"doppler_core.py lives in SDR_Radar_Deploy, one folder above this flowgraph.\"\
      \"\"\n    try:\n        here = os.path.dirname(os.path.abspath(__file__))\n\
      \    except NameError:                                   # GRC loads the block\
      \ source without __file__\n        here = os.getcwd()\n    for d in (here, os.path.dirname(here),\
      \ os.getcwd(), os.path.dirname(os.getcwd())):\n        if os.path.exists(os.path.join(d,\
      \ \"doppler_core.py\")):\n            if d not in sys.path:\n              \
      \  sys.path.insert(0, d)\n            import doppler_core\n            return\
      \ doppler_core, d\n    raise ImportError(\"doppler_core.py not found: keep the\
      \ gnuradio folder inside SDR_Radar_Deploy\")\n\n\nCLIP_LEVEL = 0.9    # leakage\
      \ tone above 90 % of ADC full scale = receiver overload\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Doppler Speed Camera: speed in km/h, last-speed hold, capture over\
      \ the limit, log, Arduino\"\"\"\n\n    def __init__(self, freq_mhz=2482.0, max_kmh=50.0,\
      \ limit_kmh=10.0, alarm_kmh=10.0, arduino_port=\"auto\",\n                 pluto_uri=\"\
      ip:192.168.2.1\", min_signal_db=15.0):\n        gr.sync_block.__init__(self,\
      \ name=\"Doppler Speed Camera\", in_sig=[np.complex64], out_sig=None)\n    \
      \    # GRC updates these attributes when the sliders move; work() applies them\n\
      \        self.freq_mhz, self.max_kmh, self.limit_kmh = freq_mhz, max_kmh, limit_kmh\n\
      \        self.alarm_kmh, self.arduino_port, self.pluto_uri = alarm_kmh, arduino_port,\
      \ pluto_uri\n        self.min_signal_db = min_signal_db\n        self.dc, base\
      \ = _import_core()\n        self.log_file = os.path.join(base, \"speed_log.csv\"\
      )\n        self.det = self.cam = None\n        self.applied = None\n       \
      \ self.buf = np.zeros(0, np.complex64)\n        self.kmh = self.snr = 0.0  \
      \                     # latest frame, for the display\n        self.level =\
      \ 0.0                                # TX->RX leakage level (1.0 = ADC full\
      \ scale)\n        self.arduino = None\n\n    # --- GNU Radio start/stop --------------------------------------------------------------------\n\
      \    def start(self):\n        self._apply_settings()\n        port = str(self.arduino_port).strip()\n\
      \        if port.lower() == \"auto\":\n            try:\n                from\
      \ arduino_port import find_arduino_port\n                port = find_arduino_port()\
      \ or \"\"\n            except ImportError:\n                port = \"\"\n  \
      \      if port and port.lower() != \"none\":\n            try:\n           \
      \     import serial\n                import time\n                self.arduino\
      \ = serial.Serial(port, 115200, timeout=0)\n                time.sleep(2)  \
      \                         # Nano resets when the port opens\n              \
      \  print(f\"Doppler camera: sending speed to Arduino on {port}\")\n        \
      \    except Exception as e:                      # radar keeps running without\
      \ the display\n                print(f\"Doppler camera: Arduino on {port} not\
      \ available ({e})\")\n                self.arduino = None\n        return True\n\
      \n    def stop(self):\n        if self.cam:\n            self.cam.finish() \
      \                          # log a pass still in progress\n        if self.arduino:\n\
      \            try:\n                self.arduino.write(self.cam.arduino_line(0,\
      \ 0, self.alarm_kmh).encode())\n                self.arduino.close()\n     \
      \       except Exception:\n                pass\n            self.arduino =\
      \ None\n        self._mute_tx()\n        return True\n\n    def _mute_tx(self):\n\
      \        \"\"\"The PlutoSDR Sink leaves the TX LO on when the flowgraph stops:\
      \ set -89 dB so nothing radiates.\"\"\"\n        try:\n            import iio\n\
      \            phy = iio.Context(str(self.pluto_uri)).find_device(\"ad9361-phy\"\
      )\n            phy.find_channel(\"voltage0\", True).attrs[\"hardwaregain\"].value\
      \ = \"-89\"\n            print(\"Doppler camera: transmitter muted (-89 dB)\"\
      )\n        except Exception as e:\n            print(f\"Doppler camera: could\
      \ not mute the transmitter ({e})\")\n\n    # --- settings from the GUI sliders\
      \ ------------------------------------------------------------\n    def _apply_settings(self):\n\
      \        fc = float(self.freq_mhz) * 1e6\n        settings = (fc, float(self.max_kmh),\
      \ float(self.limit_kmh), float(self.min_signal_db))\n        if settings ==\
      \ self.applied:\n            return\n        dc = self.dc\n        max_doppler\
      \ = dc.kmh_to_doppler(min(float(self.max_kmh), dc.max_speed_kmh(fc)), fc)\n\
      \        if self.det is None:\n            self.det = dc.Detector(max_doppler,\
      \ float(self.min_signal_db))\n            self.cam = dc.SpeedCamera(fc, float(self.limit_kmh),\
      \ self.log_file)\n        else:\n            if self.applied[0] != fc:\n   \
      \             self.det.reset()                        # new frequency: learn\
      \ the background again\n            self.det.set_max_doppler(max_doppler)\n\
      \            self.det.detect_db = float(self.min_signal_db)\n            self.cam.fc,\
      \ self.cam.limit = fc, float(self.limit_kmh)\n        self.applied = settings\n\
      \        print(f\"Doppler camera: {fc / 1e6:g} MHz, speeds up to \"\n      \
      \        f\"{dc.doppler_to_kmh(self.det.max_doppler_hz, fc):.0f} km/h \"\n \
      \             f\"(max possible {dc.max_speed_kmh(fc):.0f}), resolution \"\n\
      \              f\"{dc.doppler_to_kmh(dc.FS_DOPPLER / dc.NFFT, fc):.2f} km/h,\
      \ limit {float(self.limit_kmh):g} km/h, \"\n              f\"min signal {float(self.min_signal_db):g}\
      \ dB\")\n\n    # --- processing --------------------------------------------------------------------------------\n\
      \    def work(self, input_items, output_items):\n        self._apply_settings()\n\
      \        dc, n = self.dc, len(input_items[0])\n        self.buf = np.concatenate([self.buf,\
      \ input_items[0]])\n        while len(self.buf) >= dc.FRAME:\n            frame,\
      \ self.buf = self.buf[:dc.FRAME], self.buf[dc.FRAME:]\n            p_db, thr_db,\
      \ noise_db, k, snr, confirmed = self.det(frame.astype(complex))\n          \
      \  kmh, proximity, ended = self.cam.update(self.det, p_db, k, snr, confirmed)\n\
      \            self.kmh, self.snr = kmh, snr\n            self.level = float(np.abs(frame).mean())\n\
      \            if self.arduino:\n                try:\n                    self.arduino.write(self.cam.arduino_line(kmh,\
      \ proximity, float(self.alarm_kmh)).encode())\n                except Exception:\n\
      \                    self.arduino = None\n        return n\n\n    # --- display\
      \ (polled by Function Probe blocks) ---------------------------------------------------\n\
      \    def live_text(self):\n        # receiver overload: more TX power or RX\
      \ gain than the ADC can take\n        warn = \"   !! CLIPPING: raise TX attenuation\
      \ or lower RX gain\" if self.level > CLIP_LEVEL else \"\"\n        if self.det\
      \ is None or not self.det.ready:\n            return \"learning background ...\
      \ stand still\" + warn\n        if self.kmh == 0:\n            return \"no target\"\
      \ + warn\n        way = \"approaching\" if self.kmh > 0 else \"receding\"\n\
      \        flag = \"   OVER LIMIT\" if abs(self.kmh) > float(self.limit_kmh) else\
      \ \"\"\n        return f\"{abs(self.kmh):.1f} km/h {way}   (signal {self.snr:.0f}\
      \ dB){flag}{warn}\"\n\n    def held_text(self):\n        cam = self.cam\n  \
      \      if cam is None or cam.last_kmh is None:\n            return \"--   (no\
      \ pass yet)\"\n        way = \"approaching\" if cam.last_kmh > 0 else \"receding\"\
      \n        tag = f\"   CAPTURED - OVER {float(self.limit_kmh):g} km/h\" if cam.last_captured\
      \ else \"\"\n        return (f\"{abs(cam.last_kmh):.1f} km/h {way} at {cam.last_time}{tag}\
      \   |   \"\n                f\"top {cam.top_kmh:.1f} km/h, captured {cam.n_captured}\"\
      )\n"
    affinity: ''
    alarm_kmh: max(limit_kmh, 10)
    alias: ''
    arduino_port: arduino_port
    comment: ''
    freq_mhz: freq_mhz
    limit_kmh: limit_kmh
    max_kmh: max_kmh
    maxoutbuf: '0'
    min_signal_db: min_signal
    minoutbuf: '0'
    pluto_uri: pluto_uri
  states:
    _io_cache: '(''Doppler Speed Camera'', ''blk'', [(''freq_mhz'', ''2482.0''), (''max_kmh'',
      ''50.0''), (''limit_kmh'', ''10.0''), (''alarm_kmh'', ''10.0''), (''arduino_port'',
      "''auto''"), (''pluto_uri'', "''ip:192.168.2.1''"), (''min_signal_db'', ''15.0'')],
      [(''0'', ''complex'', 1)], [], ''Doppler Speed Camera: speed in km/h, last-speed
      hold, capture over the limit, log, Arduino'', [''alarm_kmh'', ''arduino_port'',
      ''freq_mhz'', ''limit_kmh'', ''max_kmh'', ''min_signal_db'', ''pluto_uri''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 392.0]
    rotation: 0
    state: enabled
