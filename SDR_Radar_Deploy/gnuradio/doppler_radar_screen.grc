- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: |
      """
      Doppler Speed + Range Camera - GNU Radio embedded Python block of doppler_radar_screen.grc.

      Inputs: two complex Doppler signals at 8 kS/s, one for each transmitted tone (tone A and tone B, delta_f apart),
      mixed to 0 Hz by identical filter chains.
      Speed: input 0 goes through the same processing as the normal radar (doppler_core.py: clutter map, mirror test,
      sub-bin peak, pass tracking, capture over the speed limit, speed_log.csv, Arduino LED/buzzer).
      Range (dual-frequency CW): a moving target appears at the same Doppler bin in both inputs. Its echo is delayed by
      2R/c, so the phase difference between the two inputs at that bin is -4 pi delta_f R / c. The TX->RX leakage
      (the 0 Hz part of each input, range ~0) gives the reference phase, which cancels the unknown start offset
      between the Pluto's transmit and receive streams:
          R = -c / (4 pi delta_f) * wrap(phase_target - phase_leakage) (mod c / (2 delta_f)) + range offset
      """
      import os
      import sys
      from collections import deque
      import numpy as np
      from gnuradio import gr


      def _import_core():
          """doppler_core.py lives in SDR_Radar_Deploy, one folder above this flowgraph."""
          try:
              here = os.path.dirname(os.path.abspath(__file__))
          except NameError:                                   # GRC loads the block source without __file__
              here = os.getcwd()
          for d in (here, os.path.dirname(here), os.getcwd(), os.path.dirname(os.getcwd())):
              if os.path.exists(os.path.join(d, "doppler_core.py")):
                  if d not in sys.path:
                      sys.path.insert(0, d)
                  import doppler_core
                  return doppler_core, d
          raise ImportError("doppler_core.py not found: keep the gnuradio folder inside SDR_Radar_Deploy")


      CLIP_LEVEL = 0.9    # leakage tone above 90 % of ADC full scale = receiver overload
      C = 299792458.0
      RANGE_AVG = 7       # median of this many range readings (about 0.45 s)


      class blk(gr.sync_block):
          """Doppler Speed + Range Camera: speed in km/h, range in m (dual-frequency CW), capture, log, Arduino"""

          def __init__(self, freq_mhz=2482.0, max_kmh=50.0, limit_kmh=10.0, alarm_kmh=10.0, arduino_port="auto",
                       pluto_uri="ip:192.168.2.1", min_signal_db=15.0, tone_a_hz=-1.3e6, tone_b_hz=1.7e6,
                       range_offset_m=0.0):
              gr.sync_block.__init__(self, name="Doppler Speed + Range Camera", in_sig=[np.complex64, np.complex64],
                                     out_sig=None)
              # GRC updates these attributes when the controls change; work() applies them
              self.freq_mhz, self.max_kmh, self.limit_kmh = freq_mhz, max_kmh, limit_kmh
              self.alarm_kmh, self.arduino_port, self.pluto_uri = alarm_kmh, arduino_port, pluto_uri
              self.min_signal_db = min_signal_db
              self.tone_a_hz, self.tone_b_hz, self.range_offset_m = tone_a_hz, tone_b_hz, range_offset_m
              self.dc, base = _import_core()
              self.log_file = os.path.join(base, "speed_log.csv")
              self.det = self.cam = None
              self.applied = None
              self.buf_a = np.zeros(0, np.complex64)
              self.buf_b = np.zeros(0, np.complex64)
              self.hist_b = np.zeros(self.dc.NFFT, complex)
              self.kmh = self.snr = 0.0                       # latest frame, for the display
              self.range_m = None                             # measured range of the current target (m)
              self.ranges = deque(maxlen=RANGE_AVG)
              self.level = 0.0                                # TX->RX leakage level (1.0 = ADC full scale)
              self.arduino = None

          @property
          def delta_f(self):
              return abs(float(self.tone_b_hz) - float(self.tone_a_hz))

          @property
          def max_unambiguous_m(self):
              return C / (2 * self.delta_f)

          # --- GNU Radio start/stop --------------------------------------------------------------------
          def start(self):
              self._apply_settings()
              port = str(self.arduino_port).strip()
              if port.lower() == "auto":
                  try:
                      from arduino_port import find_arduino_port
                      port = find_arduino_port() or ""
                  except ImportError:
                      port = ""
              if port and port.lower() != "none":
                  try:
                      import serial
                      import time
                      self.arduino = serial.Serial(port, 115200, timeout=0)
                      time.sleep(2)                           # Nano resets when the port opens
                      print(f"Doppler camera: sending speed to Arduino on {port}")
                  except Exception as e:                      # radar keeps running without the display
                      print(f"Doppler camera: Arduino on {port} not available ({e})")
                      self.arduino = None
              return True

          def stop(self):
              if self.cam:
                  self.cam.finish()                           # log a pass still in progress
              if self.arduino:
                  try:
                      self.arduino.write(self.cam.arduino_line(0, 0, self.alarm_kmh).encode())
                      self.arduino.close()
                  except Exception:
                      pass
                  self.arduino = None
              self._mute_tx()
              return True

          def _mute_tx(self):
              """The PlutoSDR Sink leaves the TX LO on when the flowgraph stops: set -89 dB so nothing radiates."""
              try:
                  import iio
                  phy = iio.Context(str(self.pluto_uri)).find_device("ad9361-phy")
                  phy.find_channel("voltage0", True).attrs["hardwaregain"].value = "-89"
                  print("Doppler camera: transmitter muted (-89 dB)")
              except Exception as e:
                  print(f"Doppler camera: could not mute the transmitter ({e})")

          # --- settings from the GUI controls -----------------------------------------------------------
          def _apply_settings(self):
              fc = float(self.freq_mhz) * 1e6
              settings = (fc, float(self.max_kmh), float(self.limit_kmh), float(self.min_signal_db))
              if settings == self.applied:
                  return
              dc = self.dc
              max_doppler = dc.kmh_to_doppler(min(float(self.max_kmh), dc.max_speed_kmh(fc)), fc)
              if self.det is None:
                  self.det = dc.Detector(max_doppler, float(self.min_signal_db))
                  self.cam = dc.SpeedCamera(fc, float(self.limit_kmh), self.log_file)
              else:
                  if self.applied[0] != fc:
                      self.det.reset()                        # new frequency: learn the background again
                  self.det.set_max_doppler(max_doppler)
                  self.det.detect_db = float(self.min_signal_db)
                  self.cam.fc, self.cam.limit = fc, float(self.limit_kmh)
              self.applied = settings
              print(f"Doppler camera: {fc / 1e6:g} MHz, speeds up to "
                    f"{dc.doppler_to_kmh(self.det.max_doppler_hz, fc):.0f} km/h, limit {float(self.limit_kmh):g} km/h, "
                    f"min signal {float(self.min_signal_db):g} dB, range by 2 tones {self.delta_f / 1e6:g} MHz apart "
                    f"(unambiguous {self.max_unambiguous_m:.0f} m)")

          # --- processing --------------------------------------------------------------------------------
          def work(self, input_items, output_items):
              self._apply_settings()
              dc, n = self.dc, len(input_items[0])
              self.buf_a = np.concatenate([self.buf_a, input_items[0]])
              self.buf_b = np.concatenate([self.buf_b, input_items[1][:n]])
              while len(self.buf_a) >= dc.FRAME and len(self.buf_b) >= dc.FRAME:
                  fa, self.buf_a = self.buf_a[:dc.FRAME], self.buf_a[dc.FRAME:]
                  fb, self.buf_b = self.buf_b[:dc.FRAME], self.buf_b[dc.FRAME:]
                  self.hist_b = np.concatenate([self.hist_b[len(fb):], fb.astype(complex)])
                  p_db, thr_db, noise_db, k, snr, confirmed = self.det(fa.astype(complex))
                  kmh, proximity, ended = self.cam.update(self.det, p_db, k, snr, confirmed)
                  self.kmh, self.snr = kmh, snr
                  self.level = float(np.abs(fa).mean())
                  if proximity > 0:
                      r = self._range(k)
                      if r is not None:
                          self.ranges.append(r)
                      self.range_m = float(np.median(self.ranges)) if self.ranges else None
                  else:
                      self.ranges.clear()
                      self.range_m = None
                  if self.arduino:
                      try:
                          self.arduino.write(self.cam.arduino_line(kmh, proximity, float(self.alarm_kmh)).encode())
                      except Exception:
                          self.arduino = None
              return n

          def _range(self, k):
              """Range (m) of the echo at Doppler bin k from the phase difference between the two tones."""
              ha, hb = self.det.history, self.hist_b
              la, lb = ha.mean(), hb.mean()                   # TX->RX leakage of each tone: the reference
              if abs(la) == 0 or abs(lb) == 0:
                  return None
              w = self.det.window
              A = np.fft.fftshift(np.fft.fft((ha - la) * w))
              B = np.fft.fftshift(np.fft.fft((hb - lb) * w))
              sl = slice(max(k - 1, 0), k + 2)
              target = np.angle(np.sum(B[sl] * np.conj(A[sl])))
              ref = np.angle(lb * np.conj(la))
              d = np.angle(np.exp(1j * (target - ref)))     # wrap to -pi..pi
              sign = 1.0 if float(self.tone_b_hz) > float(self.tone_a_hz) else -1.0
              r = (-sign * d * C / (4 * np.pi * self.delta_f)) % self.max_unambiguous_m
              return float(r + float(self.range_offset_m))

          # --- display text (kept for the console and for debugging) ---------------------------------------
          def live_text(self):
              warn = "   !! CLIPPING: raise TX attenuation or lower RX gain" if self.level > CLIP_LEVEL else ""
              if self.det is None or not self.det.ready:
                  return "learning background ... stand still" + warn
              if self.kmh == 0:
                  return "no target" + warn
              way = "approaching" if self.kmh > 0 else "receding"
              rng = f"  at {self.range_m:.1f} m" if self.range_m is not None else ""
              flag = "   OVER LIMIT" if abs(self.kmh) > float(self.limit_kmh) else ""
              return f"{abs(self.kmh):.1f} km/h {way}{rng}   (signal {self.snr:.0f} dB){flag}{warn}"
    affinity: ''
    alarm_kmh: max(limit_kmh, 10)
    alias: ''
    arduino_port: arduino_port
    comment: ''
    freq_mhz: freq_mhz
    limit_kmh: limit_kmh
    max_kmh: max_kmh
    maxoutbuf: '0'
    min_signal_db: min_signal
    minoutbuf: '0'
    pluto_uri: pluto_uri
    tone_a_hz: tone_hz
    tone_b_hz: tone_b
    range_offset_m: range_offset
  states:
    _io_cache: '(''Doppler Speed Camera'', ''blk'', [(''freq_mhz'', ''2482.0''), (''max_kmh'', ''50.0''), (''limit_kmh'', ''10.0''), (''alarm_kmh'', ''10.0''), (''arduino_port'', "''auto''"), (''pluto_uri'', "''ip:192.168.2.1''"), (''min_signal_db'', ''15.0'')], [(''0'', ''complex'', 1)], [], ''Doppler Speed Camera: speed in km/h, last-speed hold, capture over the limit, log, Arduino'', [''alarm_kmh'', ''arduino_port'', ''freq_mhz'', ''limit_kmh'', ''max_kmh'', ''min_signal_db'', ''pluto_uri''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 880
    - 480
    rotation: 0
    state: enabled
