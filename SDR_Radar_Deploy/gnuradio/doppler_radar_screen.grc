options:
  parameters:
    author: SDR Doppler Radar Project Team
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Dual-frequency CW radar on the ADALM-PLUTO: speed from the Doppler shift, range from the phase difference of two tones; radar console with PPI display, velocity map, Doppler profile'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: doppler_radar_screen
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: SDR Doppler Radar - Radar Console (PlutoSDR, speed + range)
    window_size: (1600,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8.0
    rotation: 0
    state: enabled
